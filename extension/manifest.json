{
  "manifest_version": 3,
  "name": "Article PDF Scrapper",
  "version": "1.0",
  "description": "Convert any current web page or article link into a clean, formatted PDF instantly.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Convert Article to PDF"
  }
}
